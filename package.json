{
  "name": "scenario_expo",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "start": "expo start",
    "dev": "npx expo start --dev-client",
    "ios": "expo run:ios",
    "rebuild:ios": "rm -rf ios/Pods ios/Podfile.lock && npx expo prebuild --clean && npx expo run:ios",
    "upgrade": "npx expo install --fix",
    "ios:prebuild": "npx expo prebuild --platform ios",
    "ios:build:clean": "xcodebuild clean -workspace ios/Scenario.xcworkspace -scheme Scenario -configuration Debug -destination 'generic/platform=iOS'",
    "ios:build:debug": "xcodebuild -workspace ios/Scenario.xcworkspace -scheme Scenario -configuration Debug -destination 'generic/platform=iOS' -derivedDataPath ios/build",
    "ios:build:release": "xcodebuild -workspace ios/Scenario.xcworkspace -scheme Scenario -configuration Scenario -destination 'generic/platform=iOS' -derivedDataPath ios/build",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "dependencies": {
    "@expo/ui": "~56.0.18",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@react-navigation/native": "7.1.8",
    "expo": "~56.0.12",
    "expo-blur": "~56.0.3",
    "expo-build-properties": "~56.0.19",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.18",
    "expo-crypto": "~56.0.4",
    "expo-font": "~56.0.7",
    "expo-glass-effect": "~56.0.4",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.11",
    "expo-image-picker": "~56.0.18",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.14",
    "expo-local-authentication": "~56.0.4",
    "expo-localization": "~56.0.6",
    "expo-router": "~56.2.11",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-web-browser": "~56.0.5",
    "formik": "2.4.6",
    "i18n-js": "4.5.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-image-colors": "^2.6.0",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3",
    "scenario-context-menu": "file:./modules/scenario-context-menu",
    "scenario-navigation-appearance": "file:./modules/scenario-navigation-appearance",
    "scenario-toast": "file:./modules/scenario-toast",
    "yup": "1.7.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "dotenv": "^17.4.2",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "private": true
}
